{
  "functions": {
    "source": "functions",
    "codebase": "cf-ai-gateway",
    "runtime": "nodejs24",
    "ignore": ["node_modules", ".git", ".env*", ".secret*", "*.test.mjs", "*-debug.log"]
  },
  "hosting": {
    "site": "cf-ai-gateway",
    "public": "dist",
    "rewrites": [
      { "source": "/api/auth/google/token", "function": "aiGatewayGoogleToken" },
      { "source": "/api/**", "function": "aiGatewayApi" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": {
    "hosting": { "host": "127.0.0.1", "port": 5500 },
    "functions": { "host": "127.0.0.1", "port": 5501 },
    "ui": { "enabled": false }
  }
}
